{
  config,
  lib,
  myNurPkgs,
  pkgs,
  ...
}:
let
  cfg = config.modules.desktop.rime;

  # 86 jidian wubi (极点五笔) by KyleBing, Apache-2.0. Only the schemas and
  # dictionaries are installed; upstream's default/squirrel/weasel customs are
  # personal preferences, which live in jidian.custom.yaml instead.
  rime-data-jidian = pkgs.stdenvNoCC.mkDerivation {
    pname = "rime-data-wubi86-jidian";
    version = "0-unstable-2026-10-10";
    src = pkgs.fetchFromGitHub {
      owner = "KyleBing";
      repo = "rime-wubi86-jidian";
      rev = "18a6016c3d08a20f713f8f8e1791a2e79e0be081";
      hash = "sha256-NTjBrJ+h+mFsWvkMtjJdI4K2Ven2GoPqDKCUyKdb5Vo=";
    };
    installPhase = ''
      runHook preInstall
      dir=$out/share/rime-data
      install -Dm644 -t $dir *.schema.yaml *.dict.yaml
      # The schemas import the `default` preset; take Rime's prelude from rime-data.
      for f in default.yaml key_bindings.yaml punctuation.yaml symbols.yaml; do
        install -Dm644 ${pkgs.rime-data}/share/rime-data/$f $dir/$f
      done
      # Shared default schema list; Rime layers it on top of default.yaml.
      cat > $dir/default.custom.yaml <<'EOF'
      patch:
        schema_list:
          - schema: wubi86_jidian_pinyin
          - schema: wubi86_jidian
          - schema: pinyin_simp
      EOF
      runHook postInstall
    '';
    meta = {
      description = "86 jidian wubi schemas for Rime";
      homepage = "https://github.com/KyleBing/rime-wubi86-jidian";
      license = lib.licenses.asl20;
      platforms = lib.platforms.all;
    };
  };

  schemas = {
    # flypy (小鹤音形) rime data from nur-ryan4yin (`pkgs/rime-data-flypy`). The
    # package stays pristine; personal preferences live in flypy.custom.yaml.
    flypy = {
      data = myNurPkgs.rime-data-flypy;
      userFiles = {
        "flypy.custom.yaml" = ./flypy.custom.yaml;
        # Manually maintained user dictionary (custom phrases, symbols, missing
        # characters); Rime reads it from the user directory.
        "flypy_user.txt" = ./flypy_user.txt;
      };
    };
    # The same customisation patches both the default mixed wubi/pinyin schema
    # and the plain wubi one listed after it.
    jidian = {
      data = rime-data-jidian;
      userFiles = {
        "wubi86_jidian_pinyin.custom.yaml" = ./jidian.custom.yaml;
        "wubi86_jidian.custom.yaml" = ./jidian.custom.yaml;
      };
    };
  };
  selected = schemas.${cfg.schema};
in
{
  options.modules.desktop.rime.schema = lib.mkOption {
    type = lib.types.enum (builtins.attrNames schemas);
    default = "jidian";
    description = ''
      Rime schema set for fcitx5-rime (Linux) and Squirrel (macOS): `jidian`
      (86 wubi, mixed wubi/pinyin by default) or `flypy` (小鹤音形).
    '';
  };

  config = lib.mkMerge [
    # Linux: fcitx5-rime, with its user directory in ~/.local/share/fcitx5/rime.
    (lib.mkIf pkgs.stdenv.hostPlatform.isLinux {
      i18n.inputMethod.fcitx5.addons = [
        (pkgs.fcitx5-rime.override { rimeDataPkgs = [ selected.data ]; })
      ];
      xdg.dataFile = lib.mapAttrs' (
        name: source: lib.nameValuePair "fcitx5/rime/${name}" { inherit source; }
      ) selected.userFiles;
    })

    # macOS: Squirrel reads shared data from ~/Library/Rime, so link the data there.
    # flypy's `flypy_user.txt` template overlaps our dictionary, so the regular files
    # below must win. This is the only recursive link in the configuration.
    (lib.mkIf pkgs.stdenv.hostPlatform.isDarwin {
      home.fileOverlapResolution = "override";
      home.file = {
        "Library/Rime" = {
          source = "${selected.data}/share/rime-data";
          recursive = true;
          # overwrite possible existing data dynamically generated by squirrel
          force = true;
        };
      }
      // lib.mapAttrs' (
        name: source: lib.nameValuePair "Library/Rime/${name}" { inherit source; }
      ) selected.userFiles;
    })
  ];
}
